rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidThemePreset(preset) {
      return preset is string && preset.size() <= 32 &&
        preset in ['alabaster', 'obsidian', 'midnight', 'sage', 'sand', 'custom'];
    }

    function isValidVoiceName(voice) {
      return voice is string && voice.size() <= 32 &&
        voice in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir', 'Orus'];
    }

    function isValidLanguageCode(lang) {
      return lang is string && lang.size() >= 2 && lang.size() <= 16 &&
        lang in ['auto', 'en', 'hi', 'hinglish', 'bn', 'mr', 'ta', 'te', 'gu', 'pa', 'ur', 'es', 'fr', 'ar'];
    }

    function isValidCategory(category) {
      return category is string && category.size() <= 40 &&
        category in ['general', 'opportunity', 'coding', 'learning', 'writing', 'custom'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'photoURL',
          'themePreset', 'customBgColor', 'voiceReplyEnabled', 'voiceName',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL',
          'themePreset', 'customBgColor', 'voiceReplyEnabled', 'voiceName',
          'preferredLanguage', 'voiceAutoSend',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        isValidThemePreset(data.themePreset) &&
        data.customBgColor is string && data.customBgColor.size() == 7 &&
        data.customBgColor.matches('^#[0-9a-fA-F]{6}$') &&
        data.voiceReplyEnabled is bool &&
        isValidVoiceName(data.voiceName) &&
        (!('preferredLanguage' in data) || isValidLanguageCode(data.preferredLanguage)) &&
        (!('voiceAutoSend' in data) || data.voiceAutoSend is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatPage(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'category', 'systemInstruction',
          'pinned', 'messageCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'title', 'category', 'systemInstruction',
          'pinned', 'messageCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        isValidCategory(data.category) &&
        data.systemInstruction is string && data.systemInstruction.size() <= 4000 &&
        data.pinned is bool &&
        data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, pageId) {
      return data.keys().hasAll([
          'ownerId', 'pageId', 'role', 'content', 'usedVoice', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'pageId', 'role', 'content', 'usedVoice', 'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.pageId) &&
        data.pageId == pageId &&
        data.role is string && data.role.size() <= 16 && data.role in ['user', 'model'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 32000 &&
        data.usedVoice is bool &&
        data.createdAt is timestamp;
    }

    function isValidOpportunityTemplate(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'description', 'category',
          'systemInstruction', 'starterPrompt', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'title', 'description', 'category',
          'systemInstruction', 'starterPrompt', 'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 400 &&
        data.category is string && data.category.size() <= 40 &&
        data.category in ['opportunity', 'coding', 'learning', 'writing', 'custom'] &&
        data.systemInstruction is string && data.systemInstruction.size() >= 1 && data.systemInstruction.size() <= 4000 &&
        data.starterPrompt is string && data.starterPrompt.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidYouTubeChannel(data, channelId) {
      return data.keys().hasAll([
          'ownerId', 'channelId', 'title', 'handle',
          'channelUrl', 'avatarUrl', 'description', 'recentVideos',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'channelId', 'title', 'handle',
          'channelUrl', 'avatarUrl', 'description', 'recentVideos',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.channelId) &&
        data.channelId == channelId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.handle is string && data.handle.size() <= 100 &&
        data.channelUrl is string && data.channelUrl.size() >= 1 && data.channelUrl.size() <= 500 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
        data.description is string && data.description.size() <= 1000 &&
        data.recentVideos is list && data.recentVideos.size() <= 15 &&
        (
          data.recentVideos.size() == 0 ||
          (
            data.recentVideos[0] is map &&
            data.recentVideos[0].keys().hasAll(['videoId', 'title', 'url', 'publishedAt']) &&
            data.recentVideos[0].keys().hasOnly(['videoId', 'title', 'url', 'publishedAt'])
          )
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['themePreset', 'customBgColor', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['voiceReplyEnabled', 'voiceName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['voiceReplyEnabled', 'voiceName', 'voiceAutoSend', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['voiceAutoSend', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['preferredLanguage', 'updatedAt'])
        );
      allow delete: if false;

      match /pages/{pageId} {
        allow get: if isValidId(userId) && isValidId(pageId) && isOwner(userId) &&
          (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isValidId(userId) && isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(pageId) &&
          isOwner(userId) &&
          isValidChatPage(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(pageId) &&
          isOwner(userId) &&
          isValidChatPage(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['systemInstruction', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messageCount', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(pageId) && isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        match /messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(pageId) && isValidId(messageId) &&
            isOwner(userId) &&
            get(/databases/$(database)/documents/users/$(userId)/pages/$(pageId)).data.ownerId == request.auth.uid;
          allow list: if isValidId(userId) && isValidId(pageId) &&
            isOwner(userId) &&
            resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(pageId) && isValidId(messageId) &&
            isOwner(userId) &&
            isValidChatMessage(incoming(), pageId) &&
            incoming().createdAt == request.time &&
            exists(/databases/$(database)/documents/users/$(userId)/pages/$(pageId)) &&
            get(/databases/$(database)/documents/users/$(userId)/pages/$(pageId)).data.ownerId == request.auth.uid;
          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(pageId) && isValidId(messageId) &&
            isOwner(userId) &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(userId)/pages/$(pageId)).data.ownerId == request.auth.uid;
        }
      }

      match /opportunities/{opportunityId} {
        allow get: if isValidId(userId) && isValidId(opportunityId) && isOwner(userId) &&
          (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isValidId(userId) && isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(opportunityId) &&
          isOwner(userId) &&
          isValidOpportunityTemplate(incoming()) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(opportunityId) && isOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }

      match /youtubeChannels/{channelId} {
        allow get: if isValidId(userId) && isValidId(channelId) && isOwner(userId) &&
          (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isValidId(userId) && isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(channelId) &&
          isOwner(userId) &&
          isValidYouTubeChannel(incoming(), channelId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(channelId) &&
          isOwner(userId) &&
          isValidYouTubeChannel(incoming(), channelId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().channelId == existing().channelId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'handle', 'channelUrl', 'avatarUrl', 'description', 'recentVideos', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(channelId) && isOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }
    }
  }
}
